# Copier vers .env.local (non versionné), puis remplir.

# Navigateur : seulement des valeurs publiques (tout ce qui commence par VITE_ est visible par tous).
# En local : npx supabase status -o env donne API_URL et PUBLISHABLE_KEY.
VITE_SUPABASE_URL=http://127.0.0.1:54321
# Clé publique (sb_publishable_...). Jamais la clé secrète (sb_secret_...) ni l'ancienne service_role.
VITE_SUPABASE_PUBLISHABLE_KEY=

# Hébergement Netlify : ces deux variables se saisissent dans les réglages du site Netlify
# (Site configuration, Environment variables), jamais dans le dépôt. Valeurs publiques seulement.
# - Préproduction : https://ugbitornbspatpcowlvg.supabase.co et sa clé publique.
# - Production : l'adresse https du projet de production et sa clé publique.
# L'adresse choisie doit figurer dans connect-src de netlify.toml, sinon le navigateur la bloque.
# Rien d'autre n'est nécessaire côté Netlify : la clé secrète (sb_secret_...) et le secret Google
# ne s'y mettent jamais.

# Supabase local (lu par supabase/config.toml). Ne jamais préfixer par VITE_.
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_SECRET=
